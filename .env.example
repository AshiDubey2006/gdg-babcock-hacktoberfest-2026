# Copy to .env before using Docker Compose.
# Everything below is a safe local placeholder. Never commit your real .env file.

# Secret key used to sign login tokens. Anyone who knows it can forge a login.
# Replace the placeholder with a long random value. To make one, run:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# Which grader marks submissions. "mock" gives fixed fake grades and needs no model server.
# It is the only mode available right now.
GRADER_MODE=mock

# Email for the first superadmin account. The account is created when the backend starts,
# only if no user with this email exists yet. Leave this and the password empty to skip it.
SEED_ADMIN_EMAIL=admin@example.com

# Password for that first superadmin account. Local placeholder only, so change it and
# never reuse a real password.
SEED_ADMIN_PASSWORD=change-me-now

# Where the backend stores its data. The default is a local SQLite file called grader.db.
# Docker Compose overrides this with a file inside a Docker volume, so data survives restarts.
DATABASE_URL=sqlite:///./grader.db

# Address of the Ollama model server, used by model-backed graders (not needed in mock mode).
# Use http://localhost:11434 when the backend runs on your machine. Docker Compose overrides
# it with http://ollama:11434.
OLLAMA_URL=http://localhost:11434

# Ollama model that writes text, such as feedback or rubric checks.
OLLAMA_CHAT_MODEL=llama3.2:3b

# Ollama model that turns text into embeddings, which are numbers used to compare meaning.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
REDIS_URL=redis://localhost:6379/0

